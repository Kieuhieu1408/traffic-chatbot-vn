# Paths are optional; these are the built-in defaults.
RAG_SOURCE_DIR=data/raw/Thongtu
RAG_INDEX_DIR=data/index
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=6
RAG_MIN_SCORE=0.55

# Optional. The pipeline auto-detects this user-local fallback when a system
# Tesseract installation is unavailable.
RAG_TESSERACT_ROOT=/home/cong/.local/opt/tesseract

# Add your OpenAI API key to enable answer generation.
# Without a key the API remains usable in evidence-only mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini


# LangSmith: traces send query/history/retrieved sources/answers to this project.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-traffic-vn
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set only if your key requires an explicit workspace.
LANGSMITH_WORKSPACE_ID=

# Optional judge model; defaults to OPENAI_MODEL.
OPENAI_JUDGE_MODEL=gpt-5.4-mini

# Local A/B pilot: disabled until a collection window is planned.
RAG_AB_ENABLED=false
